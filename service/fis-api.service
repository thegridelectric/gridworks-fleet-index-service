[Unit]
Description=Fleet Index Service — the broker's connect-time authority (loopback :8080)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=fis
# Repo root as CWD so Settings' env_file=".env" resolves to the repo's .env.
WorkingDirectory=/home/fis/gridworks-fleet-index-service
ExecStart=/home/fis/gridworks-fleet-index-service/.venv/bin/fis api
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
