# Copy to .env and fill in. One file, one FIS_ prefix.
#
# Every value here is already the default — a fresh clone runs in the dev
# universe on this machine with no .env at all. This file is the deployed
# box's starting point: change the universe and the database, and
# provisioning writes the result.

# The universe this FIS serves — d (dev), h (hybrid), or w (production).
# The bare universe token, NOT the broker vhost: `hw1`, not `hw1__2`.
FIS_UNIVERSE=d1

# The service's own small Postgres, colocated with the broker.
FIS_DB_URL=postgresql+psycopg://fis:fispass@localhost:5437/fis

# The broker calls FIS over localhost from the same box; widen only
# deliberately.
FIS_API_HOST=127.0.0.1
FIS_API_PORT=8080
