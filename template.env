# Copy to .env and fill in. One file, one FIS_ prefix.

# The universe this FIS instance serves — d (dev), h (hybrid), or w
# (production). Required: a FIS holds one registry mirror, and a registry
# serves one universe. Runs partition inside it.
FIS_UNIVERSE=d1

# Required. The service's own small Postgres, colocated with the broker.
FIS_DB_URL=postgresql+psycopg://fis:fispass@localhost:5436/fis

# The broker calls FIS over localhost from the same box; widen only
# deliberately.
FIS_API_HOST=127.0.0.1
FIS_API_PORT=8080
